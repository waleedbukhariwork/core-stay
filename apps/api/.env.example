# Local Docker Compose credentials are disposable. Do not use them outside local development.
APP_ENV=local
PORT=4999
DATABASE_URL=postgres://codecore:codecore_local_only_not_for_prod@localhost:55432/codecore
LOG_LEVEL=debug

# Generate each independently: openssl rand -base64 32
AUTH_JWT_SECRET=
AUTH_VERIFICATION_SECRET=
AUTH_ISSUER=codecore-api
AUTH_AUDIENCE=codecore-mobile
# file is accepted ONLY for local; writes mode-0600 messages under /tmp/codecore-email-inbox
AUTH_EMAIL_MODE=file
# Required with AUTH_EMAIL_MODE=ses outside local (AWS SDK default credential chain)
AUTH_EMAIL_FROM=
AWS_REGION=
