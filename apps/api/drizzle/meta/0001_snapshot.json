      "checkConstraints": {
        "profile_daily_minutes": {
          "name": "profile_daily_minutes",
          "value": "\"engineering_profiles\".\"daily_minutes\" IN (5, 10, 15)"
        },
        "profile_role": {
          "name": "profile_role",
          "value": "\"engineering_profiles\".\"role\" IN ('backend','frontend','full_stack','mobile','platform','data','other')"
        },
        "profile_experience": {
          "name": "profile_experience",
          "value": "\"engineering_profiles\".\"experience\" IN ('under_1','years_1_3','years_3_5','years_5_8','years_8_plus')"
        },
        "profile_goals_nonempty": {
          "name": "profile_goals_nonempty",
          "value": "\"engineering_profiles\".\"goals\" IS NULL OR (cardinality(\"engineering_profiles\".\"goals\") > 0 AND array_ndims(\"engineering_profiles\".\"goals\") = 1 AND array_position(\"engineering_profiles\".\"goals\", NULL) IS NULL)"
        },
        "profile_technologies_nonempty": {
          "name": "profile_technologies_nonempty",
          "value": "\"engineering_profiles\".\"technologies\" IS NULL OR (cardinality(\"engineering_profiles\".\"technologies\") > 0 AND array_ndims(\"engineering_profiles\".\"technologies\") = 1 AND array_position(\"engineering_profiles\".\"technologies\", NULL) IS NULL)"
        },
        "profile_focus_areas_nonempty": {
          "name": "profile_focus_areas_nonempty",
          "value": "\"engineering_profiles\".\"focus_areas\" IS NULL OR (cardinality(\"engineering_profiles\".\"focus_areas\") > 0 AND array_ndims(\"engineering_profiles\".\"focus_areas\") = 1 AND array_position(\"engineering_profiles\".\"focus_areas\", NULL) IS NULL)"
        },
        "profile_learning_preferences_nonempty": {
          "name": "profile_learning_preferences_nonempty",
          "value": "\"engineering_profiles\".\"learning_preferences\" IS NULL OR (cardinality(\"engineering_profiles\".\"learning_preferences\") > 0 AND array_ndims(\"engineering_profiles\".\"learning_preferences\") = 1 AND array_position(\"engineering_profiles\".\"learning_preferences\", NULL) IS NULL)"
        },
        "profile_learning_approach": {
          "name": "profile_learning_approach",
          "value": "NOT (\"engineering_profiles\".\"learning_preferences\" @> ARRAY['challenge_first','explain_first']::text[])"
        }
      },
